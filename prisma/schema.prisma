generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


enum Track {
  FULL_STACK_DEVELOPMENT
  FRONTEND_DEVELOPMENT
  BACKEND_DEVELOPMENT
  UI_UX_DESIGN
  PRODUCT_MANAGEMENT
  DIGITAL_MARKETING
}


model User {
  id              Int      @id @default(autoincrement())
  firstName       String
  lastName        String
  phoneNumber     String
  emailAddress    String   @unique
  password        String
  preferredTrack  Track
  createdAt       DateTime @default(now())
}
