// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


enum Track {
  FULL_STACK_DEVELOPMENT
  FRONTEND_DEVELOPMENT
  BACKEND_DEVELOPMENT
  UI_UX_DESIGN
  PRODUCT_MANAGEMENT
  DIGITAL_MARKETING
}

enum Expertise {
  FULL_STACK_DEVELOPMENT
  FRONTEND_DEVELOPMENT
  BACKEND_DEVELOPMENT
  UI_UX_DESIGN
  PRODUCT_MANAGEMENT
  DIGITAL_MARKETING
}

enum Experience {
  ONE_THREE_YEARS
  FOUR_TO_SIX_YEARS
  SEVEN_TO_TEN_YEARS
  TEN_YEARS_AND_ABOVE
}

enum Commitment {
  ONE_HOUR
  TWO_HOURS
  THREE_HOURS
}

model User {
  id              Int      @id @default(autoincrement())
  firstName       String
  lastName        String
  phoneNumber     String
  emailAddress    String   @unique
  password        String
  preferredTrack  Track
  createdAt       DateTime @default(now())
   payments  Payment[] // One-to-many relation
}

model Mentor {
    id                Int      @id @default(autoincrement())
    firstName         String
    lastName          String
    phoneNumber       String
    emailAddress      String   @unique
    password          String
    currentJobTitle   String
    companyName       String
    experience        Experience
    expertise         Expertise
    linkedin          String
    yourWhy           String
    commitment        Commitment
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt
}

model Payment {
  
  id              Int      @id @default(autoincrement())
  userId           Int
  user             User     @relation(fields: [userId], references: [id])
  paymentReference String   @unique
  amountPaid      Float
  customerName    String
  customerEmail   String
  paidOn          DateTime
  createdAt       DateTime @default(now())
   
}
